# Two shared secrets (generate with: openssl rand -hex 24)
# Same names as the full server, so your Supabase secrets / nginx config map 1:1.
OPENCLAW_GATEWAY_TOKEN=replace-me-gateway-token
OPENCLAW_SIDECAR_TOKEN=replace-me-sidecar-token

# Optional: pin the model Codex uses. Leave blank to use Codex's default
# ChatGPT-subscription model (recommended).
CODEX_MODEL=
