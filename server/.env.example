# Copy to .env and fill in. Generate strong random values, e.g.:
#   openssl rand -hex 24

# Gateway bearer token — also set as Supabase secret OPENCLAW_TOKEN (used by metrics-insights).
OPENCLAW_GATEWAY_TOKEN=change-me-gateway-token

# Sidecar admin token — also set as Supabase secret OPENCLAW_SIDECAR_TOKEN (used by openclaw-auth).
OPENCLAW_SIDECAR_TOKEN=change-me-sidecar-token

# Optional: pin a specific OpenClaw git ref to build (default: main).
# OPENCLAW_REF=main
