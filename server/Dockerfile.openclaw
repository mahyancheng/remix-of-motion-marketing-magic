# Installs the PREBUILT OpenClaw gateway from npm and bundles the login sidecar.
#
# We install the published package instead of building from source because the
# source build compiles the whole runtime with `tsdown`, which needs ~2-3 GB of
# RAM and OOM-kills on small VMs (e.g. a 1 GB VPS). The npm package is already
# built, so there is NO compile step here — only `npm install` (light) — and it
# builds fine on tiny boxes. The app only uses the OpenAI-compatible
# /v1/chat/completions endpoint, which stock OpenClaw provides.
FROM node:24-bookworm-slim

# util-linux provides `script` (the PTY the device-code login needs);
# tini for clean signal handling; ca-certificates for TLS.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates util-linux tini \
    && rm -rf /var/lib/apt/lists/*

# Pin a known-good published version (bump as needed). This downloads the
# prebuilt OpenClaw + its runtime deps (including the Codex binary) — no build.
ARG OPENCLAW_VERSION=2026.6.1
RUN npm install -g openclaw@${OPENCLAW_VERSION} && npm cache clean --force

# Absolute path to the installed CLI entrypoint (used by entrypoint + sidecar).
ENV OPENCLAW_MJS=/usr/local/lib/node_modules/openclaw/openclaw.mjs

COPY login-sidecar.mjs /srv/login-sidecar.mjs
COPY entrypoint.sh /srv/entrypoint.sh
RUN chmod +x /srv/entrypoint.sh

# Self-contained home (a Docker volume mounts here) so config + auth persist.
ENV OPENCLAW_HOME=/data CODEX_HOME=/data/.codex
EXPOSE 18789 8790
ENTRYPOINT ["tini", "-s", "--", "/srv/entrypoint.sh"]
